# Shell scripts must keep LF endings. Git for Windows ships with
# core.autocrlf=true, so without this a checkout turns the script into CRLF and
# bash dies on the shebang ("bad interpreter") or on "\r: command not found".
*.sh text eol=lf

# Desktop entries are parsed line-by-line; a CRLF Exec= value breaks launch.
*.desktop text eol=lf
